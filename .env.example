# Copy to .env.local for local development. Every variable is optional: without
# it the related feature degrades gracefully (see README, "Configuration").
# Never commit real values.

# --- Transactional email (Resend) ------------------------------------------
# API key from https://resend.com → API Keys. Without it the appointment form
# falls back to opening the visitor's mail client (mailto:).
RESEND_API_KEY=

# Sender shown to visitors and the owner, e.g. "Mebo <offerte@example.com>".
# Must be an address on a domain verified in Resend. Defaults to Resend's
# onboarding sender, which only delivers to the account owner.
QUOTE_FROM_EMAIL=

# Where appointment requests are delivered. Defaults to the company email in
# src/lib/company.ts.
QUOTE_TO_EMAIL=

# --- Appointment database (Postgres) ---------------------------------------
# Connection string for a Postgres database (Neon via the Vercel Marketplace
# in production). The schema is created on first use. Without it every time
# slot is shown as free and nothing is reserved.
DATABASE_URL=

# --- Advertising pixels (all optional, all behind the cookie consent banner) -
# Leave empty to run without any ad scripts, cookies or consent banner.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Google Ads tag, in the form AW-XXXXXXXXX (also covers YouTube campaigns).
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion label for the appointment request, in the form AW-XXXXXXXXX/XXXX.
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_PINTEREST_TAG_ID=
